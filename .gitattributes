# Enforce LF line endings in the repository and working directory
* text=auto eol=lf

# Explicitly treat common text files as LF
*.go      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.sh      text eol=lf
*.txt     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.sql     text eol=lf
*.xml     text eol=lf

# Windows scripts keep CRLF where needed
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files - never modify line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
